<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ExpensesPanelController"
      spacing="12"
      style="-fx-padding: 16; -fx-background-color: #f8f8f8;">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Расходы"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Добавить расход" onAction="#handleAdd"
                style="-fx-background-color: #0F6E56; -fx-text-fill: white;
                       -fx-padding: 8 16; -fx-background-radius: 8;"/>
    </HBox>

    <TableView fx:id="expensesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"       prefWidth="50"/>
            <TableColumn fx:id="colProduct"  text="Товар"    prefWidth="200"/>
            <TableColumn fx:id="colQuantity" text="Кол-во"   prefWidth="80"/>
            <TableColumn fx:id="colDate"     text="Дата"     prefWidth="110"/>
            <TableColumn fx:id="colReason"   text="Причина"  prefWidth="200"/>
        </columns>
    </TableView>
</VBox>