<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ProductsPanelController"
      spacing="12"
      style="-fx-padding: 16; -fx-background-color: #f8f8f8;">

    <HBox spacing="8">
        <TextField fx:id="searchField" promptText="Поиск по названию..."
                   HBox.hgrow="ALWAYS"/>
        <Button text="Найти" onAction="#handleSearch"
                style="-fx-background-color: #185FA5; -fx-text-fill: white;
                       -fx-padding: 8 16; -fx-background-radius: 8;"/>
        <Button fx:id="btnAdd" text="+ Добавить" onAction="#handleAdd"
                style="-fx-background-color: #0F6E56; -fx-text-fill: white;
                       -fx-padding: 8 16; -fx-background-radius: 8;"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"          text="ID"        prefWidth="50"/>
            <TableColumn fx:id="colName"        text="Название"  prefWidth="180"/>
            <TableColumn fx:id="colCategory"    text="Категория" prefWidth="130"/>
            <TableColumn fx:id="colUnit"        text="Ед."       prefWidth="60"/>
            <TableColumn fx:id="colQuantity"    text="Кол-во"    prefWidth="80"/>
            <TableColumn fx:id="colMinQuantity" text="Мин."      prefWidth="60"/>
            <TableColumn fx:id="colPrice"       text="Цена"      prefWidth="90"/>
            <TableColumn fx:id="colActions"     text="Действия"  prefWidth="150"/>
        </columns>
    </TableView>
</VBox>