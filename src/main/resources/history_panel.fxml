<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="HistoryPanelController"
      spacing="12"
      style="-fx-padding: 16; -fx-background-color: #f8f8f8;">

    <Label text="🕐 История операций"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
</VBox>