<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="UserDialogController"
      spacing="14"
      style="-fx-padding: 30; -fx-background-color: white;"
      prefWidth="340">

    <Label text="Добавить пользователя"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <VBox spacing="6">
        <Label text="ФИО" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
        <TextField fx:id="fullNameField" promptText="Иванов Иван Иванович" prefWidth="280"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Логин" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
        <TextField fx:id="loginField" promptText="Логин" prefWidth="280"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Пароль" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
        <PasswordField fx:id="passwordField" promptText="Пароль" prefWidth="280"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Роль" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
        <ComboBox fx:id="roleBox" prefWidth="280"/>
    </VBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" text=""/>

    <HBox spacing="10">
        <Button text="Сохранить" onAction="#handleSave" prefWidth="130"
                style="-fx-background-color: #185FA5; -fx-text-fill: white;
                       -fx-padding: 10; -fx-background-radius: 8;"/>
        <Button text="Отмена" onAction="#handleCancel" prefWidth="130"
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333;
                       -fx-padding: 10; -fx-background-radius: 8;"/>
    </HBox>
</VBox>