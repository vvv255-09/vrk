<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="MainController"
            prefWidth="1050" prefHeight="700">

    <!-- Левое меню -->
    <left>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 1 0 0; -fx-min-width: 200px; -fx-padding: 0;">

            <!-- Инфо о пользователе -->
            <VBox style="-fx-padding: 16 12 12 12; -fx-border-color: #e0e0e0;
                         -fx-border-width: 0 0 1 0;" spacing="4">
                <Label fx:id="userNameLabel" text="—"
                       style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label fx:id="userRoleLabel" text="—"
                       style="-fx-font-size: 11px; -fx-text-fill: #185FA5;"/>
            </VBox>

            <!-- Кнопки меню -->
            <VBox fx:id="menuBox" spacing="0" style="-fx-padding: 8 0 0 0;">
                <Button fx:id="btnProducts"   text="📦  Товары"
                        onAction="#showProducts"   maxWidth="Infinity"
                        styleClass="menu-btn"/>
                <Button fx:id="btnReceipts"   text="📥  Поступления"
                        onAction="#showReceipts"   maxWidth="Infinity"
                        styleClass="menu-btn"/>
                <Button fx:id="btnExpenses"   text="📤  Расходы"
                        onAction="#showExpenses"   maxWidth="Infinity"
                        styleClass="menu-btn"/>
                <Button fx:id="btnLowStock"   text="⚠️  Низкий остаток"
                        onAction="#showLowStock"   maxWidth="Infinity"
                        styleClass="menu-btn"/>
                <Button fx:id="btnUsers"      text="👥  Пользователи"
                        onAction="#showUsers"      maxWidth="Infinity"
                        styleClass="menu-btn"/>
            </VBox>

            <!-- Кнопка выхода внизу -->
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Выйти" onAction="#logout" maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-background-color: transparent;
                           -fx-text-fill: #888; -fx-border-color: transparent;"/>
        </VBox>
    </left>

    <!-- Контент справа -->
    <center>
        <VBox spacing="12" style="-fx-padding: 16; -fx-background-color: #f8f8f8;">

            <!-- Поиск + кнопка добавить -->
            <HBox spacing="8">
                <TextField fx:id="searchField" promptText="Поиск по названию..."
                           HBox.hgrow="ALWAYS"/>
                <Button text="Найти"    onAction="#handleSearch"
                        style="-fx-background-color: #185FA5; -fx-text-fill: white; -fx-padding: 8 16;"/>
                <Button fx:id="btnAdd" text="+ Добавить" onAction="#handleAdd"
                        style="-fx-background-color: #0F6E56; -fx-text-fill: white; -fx-padding: 8 16;"/>
            </HBox>

            <!-- Таблица товаров -->
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"        prefWidth="50"/>
                    <TableColumn fx:id="colName"        text="Название"  prefWidth="180"/>
                    <TableColumn fx:id="colCategory"    text="Категория" prefWidth="130"/>
                    <TableColumn fx:id="colUnit"        text="Ед."       prefWidth="60"/>
                    <TableColumn fx:id="colQuantity"    text="Кол-во"    prefWidth="80"/>
                    <TableColumn fx:id="colMinQuantity" text="Мин."      prefWidth="60"/>
                    <TableColumn fx:id="colPrice"       text="Цена"      prefWidth="90"/>
                    <TableColumn fx:id="colActions"     text="Действия"  prefWidth="150"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>