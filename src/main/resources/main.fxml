<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="MainController"
            fx:id="rootPane"
            prefWidth="900" prefHeight="550">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>
    <left>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 1 0 0; -fx-min-width: 200px;">

            <VBox style="-fx-padding: 16 12 12 12; -fx-border-color: #e0e0e0;
                         -fx-border-width: 0 0 1 0;" spacing="4">
                <Label fx:id="userNameLabel" text="—"
                       style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label fx:id="userRoleLabel" text="—"
                       style="-fx-font-size: 11px; -fx-text-fill: #185FA5;"/>
            </VBox>

            <VBox spacing="0" style="-fx-padding: 8 0 0 0;">
                <Button fx:id="btnProducts"  text="📦  Товары"         onAction="#showProducts" maxWidth="Infinity" styleClass="menu-btn"/>
                <Button fx:id="btnReceipts"  text="📥  Поступления"    onAction="#showReceipts" maxWidth="Infinity" styleClass="menu-btn"/>
                <Button fx:id="btnExpenses"  text="📤  Расходы"        onAction="#showExpenses" maxWidth="Infinity" styleClass="menu-btn"/>
                <Button fx:id="btnLowStock"  text="⚠️  Низкий остаток" onAction="#showLowStock" maxWidth="Infinity" styleClass="menu-btn"/>
                <Button fx:id="btnUsers"     text="👥  Пользователи"   onAction="#showUsers"    maxWidth="Infinity" styleClass="menu-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Выйти" onAction="#logout" maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-background-color: transparent;
                           -fx-text-fill: #888; -fx-border-color: transparent;"/>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f8f8f8;"/>
    </center>

</BorderPane>