<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="AdminOrdersPanelController"
      spacing="12"
      style="-fx-padding: 16; -fx-background-color: #f8f8f8;">

    <Label text="📋 Управление заказами"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"      text="№"         prefWidth="50"/>
            <TableColumn fx:id="colUser"    text="Клиент"    prefWidth="150"/>
            <TableColumn fx:id="colDate"    text="Дата"      prefWidth="150"/>
            <TableColumn fx:id="colTotal"   text="Сумма"     prefWidth="110"/>
            <TableColumn fx:id="colStatus"  text="Статус"    prefWidth="130"/>
            <TableColumn fx:id="colActions" text="Действия"  prefWidth="200"/>
        </columns>
    </TableView>
</VBox>