<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ProductCardController"
      spacing="16"
      style="-fx-padding: 24; -fx-background-color: white;"
      prefWidth="480" prefHeight="520">

    <!-- Заголовок -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="nameLabel" text="—"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="categoryLabel" text="—"
                   style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
        </VBox>
    </HBox>

    <!-- Карточки с цифрами -->
    <HBox spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #E6F1FB; -fx-padding: 12;
                     -fx-background-radius: 8;">
            <Label text="Остаток"
                   style="-fx-font-size: 11px; -fx-text-fill: #185FA5;"/>
            <Label fx:id="quantityLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #EAF3DE; -fx-padding: 12;
                     -fx-background-radius: 8;">
            <Label text="Мин. остаток"
                   style="-fx-font-size: 11px; -fx-text-fill: #3B6D11;"/>
            <Label fx:id="minQuantityLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B6D11;"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #FFF3E0; -fx-padding: 12;
                     -fx-background-radius: 8;">
            <Label text="Цена"
                   style="-fx-font-size: 11px; -fx-text-fill: #854F0B;"/>
            <Label fx:id="priceLabel" text="0 сом"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #854F0B;"/>
        </VBox>
    </HBox>

    <!-- История -->
    <Label text="История движений"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #f8f8f8; -fx-border-color: #e0e0e0;
                     -fx-border-radius: 8; -fx-background-radius: 8;"/>

    <Button text="Закрыть" onAction="#handleClose"
            style="-fx-background-color: #f0f0f0; -fx-text-fill: #333;
                   -fx-padding: 10 24; -fx-background-radius: 8;"/>
</VBox>